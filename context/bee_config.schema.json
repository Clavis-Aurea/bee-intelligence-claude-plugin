{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "bee_config",
  "description": "Per-project configuration for Bee Assistant. Configuration only: no credentials, tokens, or figures.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "confirmed_on": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  }
}
