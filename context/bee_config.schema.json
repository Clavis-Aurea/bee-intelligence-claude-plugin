{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "bee_config",
  "description": "Per-project configuration for Bee Assistant. Configuration only: no credentials, tokens, or figures.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_source": {
          "enum": [
            "mcp",
            "file",
            "ask"
          ],
          "description": "Which source to use by default. 'ask' means ask every time."
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sheet": {
                "type": "string"
              },
              "key_columns": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "header_row": {
                "type": "integer",
                "minimum": 1
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "locale": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "units": {
          "type": "string"
        }
      }
    },
    "reporting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "period_convention": {
          "type": "string"
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "confirmed_on": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  }
}
